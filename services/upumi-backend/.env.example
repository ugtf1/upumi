# Server
PORT=8080
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-super-secret

# Database
# SQLite works out of the box locally.
DATABASE_URL="file:./dev.db"
# Optional Postgres target for deployments that generate Prisma with prisma/schema.postgres.prisma.
POSTGRES_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upumi?schema=public"

# Login / SMS OTP
MASTER_ADMIN_PHONE=08020909745
MASTER_ADMIN_EMAIL=master-admin@upumi.local
OTP_TTL_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Traffic analytics (optional)
TRAFFIC_PROVIDER=none
# For Plausible
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
# For Umami
UMAMI_API_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
# Generic
TRAFFIC_SITE_ID=

# Google Sheet sync (optional)
# Use either GOOGLE_SHEET_URL (normal edit/share link) or GOOGLE_SHEET_CSV_URL (direct export URL)
GOOGLE_SHEET_URL=
GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_YEAR=2026

# Secret header used by Cloud Scheduler -> /api/admin/cron/sync-google-sheet
SCHEDULER_IMPORT_SECRET=
