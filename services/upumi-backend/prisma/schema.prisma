generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(cuid()) @map("user_id")
  phone       String     @unique
  role        String     @default("MEMBER")
  email       String?    @unique
  fName       String?
  lName       String?
  dateJoined  DateTime?
  voteRole    String     @default("No")
  address     String?
  monthlyDues Decimal    @default(0)
  totalPaid   Decimal    @default(0)
  outstanding Decimal    @default(0)
  status      String     @default("Active")

  otpCodeHash      String?
  otpExpiresAt     DateTime?
  otpLastSentAt    DateTime?
  masterOtpBypass  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberRecord      MemberRecord?
  dues              Due[]
  transactions      Transaction[]
  memberFinanceRows MemberFinance[]
  
}

model GeneralFinance {
  id                 String   @id @default(cuid())
  totalMembers       Int      @default(0)
  activeMembers      Int      @default(0)
  totalRevenue       Decimal  @default(0)
  pendingPayments    Decimal  @default(0)
  incomeYtd          Decimal  @default(0)
  expensesYtd        Decimal  @default(0)
  bussinessAccount   Decimal  @default(0)
  fundraiserAccount  Decimal  @default(0)
  totalAccBalance    Decimal  @default(0)
  year               Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("generalFinance")
}

model Attendance {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  usersIn   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@map("attendance")
}

model HostingSchedule {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  hostMember String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([year, month])
  @@map("hostingSchedule")
}

model Due {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, year, month])
  @@map("dues")
}

model Collection {
  id         String   @id @default(cuid())
  event      String
  amountPaid Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("collections")
}

model Transaction {
  id        String           @id @default(cuid())
  userId    String?          @map("user_id")
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName  String
  title     String
  amount    Decimal          @default(0)
  date      DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("transactions")
}

model Expense {
  id        String   @id @default(cuid())
  reason    String
  title     String
  amount    Decimal  @default(0)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}

model MemberFinance {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyDues Decimal  @default(0)
  totalPaid   Decimal  @default(0)
  outstanding Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("memberFinance")
}

model MemberRecord {
  id String @id @default(cuid())

  memberKey String @unique

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status    String?
  title     String?
  firstName String?
  lastName  String?
  joined    String?
  phone     String?
  email     String?

  whatsapp String?
  facebook String?

  goodStanding          String?
  financialGoodStanding String?
  voter                 String?
  insurance             String?
  attendancePct         String?

  rawJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monthlyDues MonthlyDue[]
}

model WorkbookRow {
  id         String   @id @default(cuid())
  sourceYear Int?
  rowOrder   Int
  rowType    String?
  title      String?
  firstName  String?
  lastName   String?
  email      String?
  hosting    String?
  rawJson    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([rowType])
  @@index([hosting])
  @@index([rowOrder])
}

model MonthlyDue {
  id             String       @id @default(cuid())
  memberRecordId String
  member         MemberRecord @relation(fields: [memberRecordId], references: [id], onDelete: Cascade)

  year     Int
  month    Int
  present  Boolean?
  duesPaid Decimal?

  createdAt DateTime @default(now())

  @@unique([memberRecordId, year, month])
}
